# Copy to .env for local development and replace placeholders locally.
# Never commit real credentials.
GROQ_API_KEY=replace_with_your_groq_api_key
# FastAPI defaults to mock execution. Set this in the server process environment to opt in.
ENABLE_LIVE_AGENTS=false

# PostgreSQL settings used by the current Python workflows.
host=replace_with_your_database_host
port=replace_with_your_database_port
database=replace_with_your_database_name
user=replace_with_your_database_user
password=replace_with_your_database_password
